datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(MENTEE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile          Profile?
  sentRequests     MentorshipRequest[] @relation("MenteeRequests")
  receivedRequests MentorshipRequest[] @relation("MentorRequests")

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  department       String
  jobTitle         String
  yearsExperience  Int      @default(0)
  certifications   String   @default("")
  rawBio           String   @db.Text
  cleanedBio       String   @default("") @db.Text
  
  // Dense 384-dimensional vector from all-MiniLM-L6-v2
  embedding        Unsupported("vector(384)")?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("profiles")
}

model MentorshipRequest {
  id              String        @id @default(uuid())
  menteeId        String
  mentorId        String
  similarityScore Float         @default(0.0)
  status          RequestStatus @default(PENDING)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  mentee          User          @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor          User          @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentorship_requests")
}